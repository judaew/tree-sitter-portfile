{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "portfile",
      "camelcase": "Portfile",
      "title": "Portfile",
      "scope": "source.portfile",
      "file-types": [
        "Portfile"
      ],
      "injection-regex": "^portfile$",
      "class-name": "TreeSitterPortfile"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Portfile grammar for tree-sitter",
    "authors": [
      {
        "name": "Vadym-Valdis Yudaiev",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/judaew/tree-sitter-portfile",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
